# WeCal — copie para .env e preencha as credenciais
# Porta exposta pelo Docker Compose
WECAL_PORT=3001

# Para executar a aplicação fora do Docker Compose (o Compose define estes valores)
# DATABASE_URL=postgres://wecal:wecal@localhost:5432/wecal
# PORT=3000

# Credenciais OAuth do Google (opcionais)
# Como obter: console.cloud.google.com → OAuth consent screen → OAuth client ID (Web)
# Redirect URI a registrar: http://localhost:3001/auth/google/callback

APP_BASE_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gere chaves aleatórias com: openssl rand -hex 32
APP_ACCESS_KEY=
# Uma chave por aplicativo cliente, separadas por vírgula
API_ACCESS_KEYS=
