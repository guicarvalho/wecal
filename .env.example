# WeCal — credenciais OAuth do Google (copie para .env e preencha)
# Como obter: console.cloud.google.com → OAuth consent screen → OAuth client ID (Web)
# Redirect URI a registrar: http://localhost:3001/auth/google/callback

APP_BASE_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gere chaves aleatórias com: openssl rand -hex 32
APP_ACCESS_KEY=
# Uma chave por aplicativo cliente, separadas por vírgula
API_ACCESS_KEYS=

# URL do PostgreSQL para produção (o Compose local define sua própria URL)
DATABASE_URL=
